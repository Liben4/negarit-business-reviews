# ---- Core -------------------------------------------------------------
SECRET_KEY=                    # >=32 random chars: python -c "import secrets;print(secrets.token_urlsafe(48))"
SITE_URL=https://negaritbusinessreview.com
SITE_NAME=Negarit Business Review
SITE_TIMEZONE=Africa/Addis_Ababa

# ---- Database (PostgreSQL only in production) -------------------------
# Use your provider's *pooled* connection string (Neon/Supabase pooler).
DATABASE_URL=

# ---- Admin bootstrap (read ONLY by `flask create-admin`, never at runtime)
ADMIN_EMAIL=
ADMIN_PASSWORD=               # >=12 chars. Remove from Vercel after bootstrapping.

# ---- Media storage ----------------------------------------------------
STORAGE_PROVIDER=cloudinary    # cloudinary | s3 | local (local = dev only)
STORAGE_API_KEY=
STORAGE_API_SECRET=
STORAGE_CLOUD_NAME=            # Cloudinary cloud name, or S3 bucket name
STORAGE_REGION=                # s3 only (e.g. eu-west-1, or "auto" for R2)
STORAGE_ENDPOINT_URL=          # s3 only, for R2/Backblaze/Spaces
STORAGE_PUBLIC_BASE_URL=       # s3 only, public/CDN base URL of the bucket

# ---- Email (transactional API) ----------------------------------------
EMAIL_PROVIDER=resend          # resend | postmark | console (dev)
EMAIL_API_KEY=
EMAIL_FROM=Negarit Business Review <no-reply@negaritbusinessreview.com>

# ---- Scheduled publishing / cron -------------------------------------
CRON_SECRET=                   # >=16 random chars; Vercel sends it as "Authorization: Bearer <value>"

# ---- Optional ---------------------------------------------------------
RATELIMIT_STORAGE_URI=         # redis://... (Upstash/Vercel KV) for cross-instance rate limits
